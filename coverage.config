<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <!-- Exclude compiler/source-generator output (only exists transiently under obj/) -->
    <Sources>
      <Exclude>
        <Source>.*/obj/.*</Source>
      </Exclude>
    </Sources>
    <!-- The builders are referenced by the test projects, so they get instrumented unless excluded -->
    <ModulePaths>
      <Exclude>
        <ModulePath>.*\.Tests\.Common\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>
  </CodeCoverage>
</Configuration>
